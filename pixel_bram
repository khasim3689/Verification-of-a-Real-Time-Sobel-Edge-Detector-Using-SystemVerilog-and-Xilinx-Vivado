module pixel_bram #(
    parameter IMG_WIDTH = 8
)(
    input wire clk,
    input wire reset,
    input wire pixel_valid,
    input wire [7:0] pixel_in,
    input wire [15:0] column,

    output reg [7:0] pixel_top,
    output reg [7:0] pixel_middle,
    output reg [7:0] pixel_bottom
);

    reg [7:0] line1 [0:IMG_WIDTH-1];
    reg [7:0] line2 [0:IMG_WIDTH-1];

    integer i;


    // Initial values
    initial begin

        pixel_top = 8'd0;
        pixel_middle = 8'd0;
        pixel_bottom = 8'd0;

        for (i = 0; i < IMG_WIDTH; i = i + 1) begin
            line1[i] = 8'd0;
            line2[i] = 8'd0;
        end

    end


    always @(posedge clk) begin

        if (reset) begin

            pixel_top <= 8'd0;
            pixel_middle <= 8'd0;
            pixel_bottom <= 8'd0;

            for (i = 0; i < IMG_WIDTH; i = i + 1) begin
                line1[i] <= 8'd0;
                line2[i] <= 8'd0;
            end

        end

        else if (pixel_valid) begin

            if (column < IMG_WIDTH) begin

                pixel_top <= line2[column];
                pixel_middle <= line1[column];
                pixel_bottom <= pixel_in;

                line2[column] <= line1[column];
                line1[column] <= pixel_in;

            end

            else begin

                pixel_top <= 8'd0;
                pixel_middle <= 8'd0;
                pixel_bottom <= 8'd0;

            end

        end

    end

endmodule
