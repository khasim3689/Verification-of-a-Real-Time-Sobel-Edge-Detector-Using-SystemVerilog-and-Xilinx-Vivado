module gradient_magnitude(
    input wire signed [11:0] gx,
    input wire signed [11:0] gy,

    output reg [12:0] magnitude
);

    reg [11:0] abs_gx;
    reg [11:0] abs_gy;

    always @(*) begin

        // Absolute value of Gx
        if (gx < 0)
            abs_gx = -gx;
        else
            abs_gx = gx;

        // Absolute value of Gy
        if (gy < 0)
            abs_gy = -gy;
        else
            abs_gy = gy;

        // Gradient magnitude approximation
        magnitude = {1'b0, abs_gx} + {1'b0, abs_gy};

    end

endmodule
